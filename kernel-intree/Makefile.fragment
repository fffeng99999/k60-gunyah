#
# Appended to drivers/virt/gunyah/Makefile by apply_intree.sh

# The VM manager is built in (=y) so it can call the non-exported
# gh_rm_call() in gh_rm_core.c. It is deliberately NOT a module: as a
# module it would need gh_rm_call() exported, which would widen the
# vendor driver's ABI for no benefit.
obj-$(CONFIG_GH_VM_MGR) += gh_vm_mgr.o

# The RM extensions must live in gh_rm_drv: they are the other half of the
# same module and the vendor module is the one that owns the msgq
# connection, the idr and the notifier chain.
gh_rm_drv-$(CONFIG_GH_VM_MGR) += gh_rm_vmmgr.o

gh_vm_mgr-y := vm_mgr.o gunyah_vcpu.o gunyah_irqfd.o gunyah_ioeventfd.o
